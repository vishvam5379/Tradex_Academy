# Django Core Settings
SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,.vercel.app

# Database Configuration
# Local development: USE_SQLITE=True
# Production / Supabase: USE_SQLITE=False
USE_SQLITE=True

# Supabase PostgreSQL Connection (When USE_SQLITE=False)
# Option 1: Individual Connection Parameters
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_supabase_db_password
DB_HOST=your_supabase_host
DB_PORT=5432
DB_SSL=True

# Option 2 (Alternative): Full Supabase connection string
# DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres?sslmode=require

# Razorpay Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_secret_key
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
RAZORPAY_CURRENCY=INR

# Subscription Settings (in INR)
PLAN_STARTER_PRICE=3999
PLAN_PRO_PRICE=9999
PLAN_ELITE_PRICE=11999

# Google OAuth 2.0 Settings
# Get credentials from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Optional: explicitly set redirect URI, otherwise automatically detected
# GOOGLE_REDIRECT_URI=https://tradex-academy-alpha.vercel.app/accounts/google/callback/

# Payment Flow Mode: 'manual_upi' (Direct QR + UTR verification) or 'razorpay' (Automated webhook payment links)
PAYMENT_MODE=manual_upi

# Manual UPI Payment Settings (Used when PAYMENT_MODE=manual_upi)
MANUAL_UPI_ID=tradex@upi
MANUAL_UPI_NAME=Tradex Academy
MANUAL_UPI_PHONE=9313858614

# Admin Emails for Manual UPI Verification Dashboard (comma-separated, allows access to /admin/payments/)
ADMIN_EMAILS=admin@tradex.com,owner@tradex.com

# Supabase Storage Configuration (for payment screenshot proofs)
# Bucket must exist in Supabase Storage with appropriate policies
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key
SUPABASE_STORAGE_BUCKET=payment-screenshots
