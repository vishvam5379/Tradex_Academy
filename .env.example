# Django Core Settings
SECRET_KEY=your-secret-key-here
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost,.vercel.app

# Database (Remote MySQL or DATABASE_URL)
# Set USE_SQLITE=True to use local/bundled SQLite, or set to False for remote DB
USE_SQLITE=True
# DATABASE_URL=mysql://user:password@host:3306/dbname
DB_NAME=trading_academy
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SSL=False

# Razorpay Credentials
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_secret_key
RAZORPAY_CURRENCY=INR

# Subscription Settings (in INR)
PLAN_STANDARD_PRICE=5000
PLAN_GOLD_PRICE=10000
PLAN_COMBO_PRICE=12500
